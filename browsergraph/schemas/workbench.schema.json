{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browsergraph.dev/schemas/workbench-2.0.json",
  "title": "BrowserGraph Hierarchical Stage Matrix Workbench",
  "description": "Macro stages, ordered atomic substeps, concrete node candidates, and complete solution routes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "title", "task", "success", "nodes",
    "candidates", "macro_stages", "stages", "solutions", "metadata"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "title": {"type": "string", "minLength": 1},
    "task": {"type": "string"},
    "success": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "node-manifest.schema.json"}
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "macro_stages": {
      "type": "array",
      "items": {"$ref": "#/$defs/macro_stage"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    },
    "solutions": {
      "type": "array",
      "items": {"$ref": "#/$defs/solution"}
    },
    "feedback_channels": {
      "type": "array",
      "items": {"$ref": "#/$defs/feedback_channel"}
    },
    "optimization_profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/optimization_profile"}
    },
    "receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/execution_receipt"}
    },
    "optimization_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/optimization_decision"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "macro_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "input_type", "output_type", "success",
        "optional", "substeps"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "input_type": {"type": "string", "minLength": 1},
        "output_type": {"type": "string", "minLength": 1},
        "success": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"},
        "substeps": {
          "type": "array", "minItems": 1,
          "items": {"type": "string"}, "uniqueItems": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "node_id", "name", "parameters", "description", "metrics", "tags"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "name": {"type": "string"},
        "parameters": {"type": "object"},
        "description": {"type": "string"},
        "metrics": {"type": "object"},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "input_type", "output_type", "success",
        "optional", "variant_axes", "required_capabilities", "macro_stage_id", "candidates"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "input_type": {"type": "string", "minLength": 1},
        "output_type": {"type": "string", "minLength": 1},
        "success": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"},
        "variant_axes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "macro_stage_id": {"type": "string"},
        "candidates": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "status", "route", "fallbacks", "metrics", "tags"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "status": {"type": "string"},
        "route": {"type": "object", "additionalProperties": {"type": "string"}},
        "fallbacks": {
          "type": "object",
          "additionalProperties": {
            "type": "array", "items": {"type": "string"}, "uniqueItems": true
          }
        },
        "metrics": {"type": "object"},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "feedback_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "signal", "scope", "producer", "consumer",
        "action", "description", "required"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "name": {"type": "string", "minLength": 1},
        "signal": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "consumer": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "required": {"type": "boolean"}
      }
    },
    "optimization_objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "weight"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "direction": {"enum": ["maximize", "minimize"]},
        "weight": {"type": "number", "minimum": 0}
      }
    },
    "optimization_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "strategy", "objectives",
        "minimum_evidence", "exploration"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "strategy": {"type": "string", "minLength": 1},
        "objectives": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/optimization_objective"}
        },
        "minimum_evidence": {"type": "number", "minimum": 0},
        "exploration": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "execution_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "solution_id", "outcome", "accepted", "verifier", "metrics",
        "stage_outcomes", "macro_stage_outcomes", "provenance", "evidence_source", "started_at",
        "completed_at", "failure_class"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "solution_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "outcome": {"type": "string", "minLength": 1},
        "accepted": {"type": ["boolean", "null"]},
        "verifier": {"type": "string"},
        "metrics": {"type": "object"},
        "stage_outcomes": {"type": "object", "additionalProperties": {"type": "object"}},
        "macro_stage_outcomes": {"type": "object", "additionalProperties": {"type": "object"}},
        "provenance": {"type": "object"},
        "evidence_source": {"type": "string"},
        "started_at": {"type": "string"},
        "completed_at": {"type": "string"},
        "failure_class": {"type": "string"}
      }
    },
    "optimization_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "scope", "profile_id", "selected", "eligible_count",
        "rejected_count", "score", "objective_values", "contributions",
        "alternatives", "evidence_snapshot", "reason", "created_at"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
        "scope": {"enum": ["stage", "substep", "macro_stage", "route"]},
        "profile_id": {"type": "string"},
        "selected": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "eligible_count": {"type": "integer", "minimum": 0},
        "rejected_count": {"type": "integer", "minimum": 0},
        "score": {"type": ["number", "null"]},
        "objective_values": {"type": "object"},
        "contributions": {"type": "object", "additionalProperties": {"type": "number"}},
        "alternatives": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_snapshot": {"type": "string"},
        "reason": {"type": "string"},
        "created_at": {"type": "string"}
      }
    }
  }
}
