{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browsergraph.dev/schemas/node-manifest-1.0.json",
  "title": "BrowserGraph Node Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "kind", "name", "version", "inputs", "outputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]*$"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
    "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
    "effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "resources": {"type": "object"},
    "runtime": {"type": "object"},
    "context": {"type": "object"},
    "intelligence": {"type": "object"},
    "metrics": {"type": "object"},
    "source": {"type": "string"},
    "docs": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "data_type", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "data_type": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "required": {"type": "boolean"},
        "semantic_type": {"type": "string"},
        "units": {"type": "string"},
        "schema": {"type": "object"}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "data_type", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "data_type": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "required": {"type": "boolean"},
        "default": {},
        "choices": {"type": "array"}
      }
    }
  }
}
