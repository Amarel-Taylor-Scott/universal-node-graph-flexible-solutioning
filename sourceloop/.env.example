# Container and database
SOURCELOOP_ENVIRONMENT=development
SOURCELOOP_WEB_PORT=8080
SOURCELOOP_DB_PASSWORD=change-me-local
SOURCELOOP_CORS_ORIGINS=http://localhost:8080
SOURCELOOP_ATTACHMENT_MAX_BYTES=10485760

# Internal practitioner runtime: mock | hermes | openclaw
SOURCELOOP_AGENT_RUNTIME=mock
SOURCELOOP_HERMES_PROFILE=sourceloop-research
SOURCELOOP_OPENCLAW_AGENT=sourceloop-practitioner
SOURCELOOP_AGENT_TIMEOUT_SECONDS=180
SOURCELOOP_MAX_INTERNAL_WORKERS=6

# Outbound email remains non-delivering by default.
SOURCELOOP_EMAIL_MODE=dry_run
SOURCELOOP_ALLOW_EXTERNAL_SEND=false
SOURCELOOP_SENDER_NAME=SourceLoop Research Assistant
SOURCELOOP_SENDER_EMAIL=research@example.invalid
SOURCELOOP_REPLY_TO_EMAIL=
SOURCELOOP_SMTP_HOST=
SOURCELOOP_SMTP_PORT=587
SOURCELOOP_SMTP_USERNAME=
SOURCELOOP_SMTP_PASSWORD=
# Prefer Docker/Kubernetes secrets in production:
SOURCELOOP_SMTP_PASSWORD_FILE=
SOURCELOOP_SMTP_STARTTLS=true
SOURCELOOP_SMTP_SSL=false
SOURCELOOP_SMTP_TIMEOUT_SECONDS=30

# Inbound mailbox: disabled | imap
SOURCELOOP_MAILBOX_MODE=disabled
SOURCELOOP_IMAP_HOST=
SOURCELOOP_IMAP_PORT=993
SOURCELOOP_IMAP_USERNAME=
SOURCELOOP_IMAP_PASSWORD=
SOURCELOOP_IMAP_PASSWORD_FILE=
SOURCELOOP_IMAP_FOLDER=INBOX
SOURCELOOP_IMAP_SSL=true
SOURCELOOP_IMAP_STARTTLS=false
SOURCELOOP_IMAP_POLL_SECONDS=30
SOURCELOOP_IMAP_MARK_SEEN=true
SOURCELOOP_IMAP_SEARCH_CRITERION=UNSEEN
SOURCELOOP_IMAP_MAX_MESSAGES=50
SOURCELOOP_WORKER_ID=mailbox-worker
SOURCELOOP_WORKER_HEARTBEAT_SECONDS=15
