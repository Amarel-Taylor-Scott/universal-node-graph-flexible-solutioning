{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-plan-projection.schema.json",
  "title": "Portable frozen-plan orchestrator projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "integration_model_version", "id", "adapter_id", "adapter_digest", "target",
    "target_version", "plan_digest", "program_digest", "registry_digest",
    "admitted_space_digest", "tasks", "limitations"
  ],
  "properties": {
    "integration_model_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "adapter_id": {"$ref": "common.schema.json#/$defs/id"},
    "adapter_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "target": {"$ref": "common.schema.json#/$defs/id"},
    "target_version": {"type": "string", "minLength": 1},
    "plan_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "program_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "registry_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "admitted_space_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "limitations": {"$ref": "#/$defs/stringArray"}
  },
  "$defs": {
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "stringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "slot_id", "candidate_id", "node_id", "node_version",
        "implementation_digest", "runtime", "entrypoint", "parameters",
        "fallback_candidate_ids", "dependencies", "effects", "permissions", "resources"
      ],
      "properties": {
        "slot_id": {"$ref": "common.schema.json#/$defs/id"},
        "candidate_id": {"$ref": "common.schema.json#/$defs/id"},
        "node_id": {"$ref": "common.schema.json#/$defs/id"},
        "node_version": {"type": "string", "minLength": 1},
        "implementation_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "runtime": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "fallback_candidate_ids": {"$ref": "#/$defs/idArray"},
        "dependencies": {"$ref": "#/$defs/idArray"},
        "effects": {"$ref": "#/$defs/idArray"},
        "permissions": {"$ref": "#/$defs/idArray"},
        "resources": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
