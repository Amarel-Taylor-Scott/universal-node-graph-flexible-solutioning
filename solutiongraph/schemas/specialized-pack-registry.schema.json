{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specialized-pack-registry.schema.json",
  "title": "Specialized capability-pack registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["specialized_pack_model_version", "id", "version", "description", "packs"],
  "properties": {
    "specialized_pack_model_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "specialized-pack.schema.json"}
    }
  }
}
