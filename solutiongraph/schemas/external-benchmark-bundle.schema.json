{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-benchmark-bundle.schema.json",
  "title": "SolutionGraph external benchmark adapter bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "external_benchmark_model_version", "adapter_id", "source_kind", "source_id",
    "source_version", "source_uri", "claim_scope", "task", "cases",
    "source_manifest_digest", "limitations"
  ],
  "properties": {
    "external_benchmark_model_version": {"const": "0.1"},
    "adapter_id": {"$ref": "common.schema.json#/$defs/id"},
    "source_kind": {"$ref": "common.schema.json#/$defs/id"},
    "source_id": {"$ref": "common.schema.json#/$defs/id"},
    "source_version": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "claim_scope": {
      "enum": ["mechanism-fixture", "internal-dataset", "public-benchmark", "production-shadow"]
    },
    "task": {"$ref": "task-contract.schema.json"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "task-case.schema.json"}},
    "source_manifest_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
