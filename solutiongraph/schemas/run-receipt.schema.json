{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-receipt.schema.json",
  "title": "Universal Node Graph Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "plan_digest", "program_digest", "task_case_id", "outcome", "accepted",
    "verifier", "verifier_digest", "assignments", "metrics", "node_receipts", "seed", "started_at",
    "completed_at", "failure_class", "executor", "environment_digest", "input_digest",
    "belief_revision", "admitted_space_digest", "output_artifacts",
    "verification_details"
  ],
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "accepted"}}},
      "then": {"properties": {"accepted": {"const": true}}}
    },
    {
      "if": {"properties": {"outcome": {"enum": ["rejected", "failed"]}}},
      "then": {"properties": {"accepted": {"const": false}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "completed_unverified"}}},
      "then": {"properties": {"accepted": {"type": "null"}}}
    }
  ],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "plan_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "program_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "task_case_id": {"$ref": "common.schema.json#/$defs/id"},
    "outcome": {
      "enum": ["accepted", "rejected", "failed", "completed_unverified"]
    },
    "accepted": {"type": ["boolean", "null"]},
    "verifier": {
      "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/id"}]
    },
    "verifier_digest": {
      "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/digest"}]
    },
    "assignments": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.:/-]*$"},
      "additionalProperties": {"$ref": "common.schema.json#/$defs/id"}
    },
    "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
    "node_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id", "candidate_id", "outcome", "started_at", "completed_at",
          "metrics", "failure_class", "artifact_digests", "attempt", "node_id",
          "implementation_digest", "runtime", "input_digest"
        ],
        "properties": {
          "slot_id": {"$ref": "common.schema.json#/$defs/id"},
          "candidate_id": {"$ref": "common.schema.json#/$defs/id"},
          "outcome": {"enum": ["succeeded", "failed", "blocked"]},
          "started_at": {"type": "string"},
          "completed_at": {"type": "string"},
          "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
          "failure_class": {
            "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/id"}]
          },
          "artifact_digests": {
            "type": "array", "items": {"$ref": "common.schema.json#/$defs/digest"}
          },
          "attempt": {"type": "integer", "minimum": 1},
          "node_id": {"type": "string"},
          "implementation_digest": {
            "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/digest"}]
          },
          "runtime": {"type": "string"},
          "runtime_adapter": {
            "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/id"}]
          },
          "isolation": {"type": "string"},
          "input_digest": {
            "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/digest"}]
          }
        }
      }
    },
    "seed": {"type": ["integer", "null"]},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "failure_class": {
      "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/id"}]
    },
    "executor": {"type": "string"},
    "environment_digest": {
      "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/digest"}]
    },
    "input_digest": {
      "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/digest"}]
    },
    "belief_revision": {"type": "string"},
    "admitted_space_digest": {
      "oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/digest"}]
    },
    "output_artifacts": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "common.schema.json#/$defs/digest"}
    },
    "verification_details": {"type": "object"}
  }
}
