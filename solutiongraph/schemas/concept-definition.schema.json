{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept-definition.schema.json",
  "title": "Semantic interrogation concept definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interrogation_model_version", "id", "version", "canonical_uri", "label",
    "description", "value_type", "aliases", "parent_ids", "jurisdictions",
    "references", "extensions"
  ],
  "properties": {
    "interrogation_model_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "canonical_uri": {"type": "string", "pattern": "^(https://|urn:)"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "value_type": {"$ref": "common.schema.json#/$defs/id"},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "parent_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "jurisdictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "role", "revision", "jurisdiction", "license", "notes"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "url": {"type": "string", "pattern": "^(https://|urn:)"},
        "role": {"$ref": "common.schema.json#/$defs/id"},
        "revision": {"type": "string"},
        "jurisdiction": {"type": "string"},
        "license": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
