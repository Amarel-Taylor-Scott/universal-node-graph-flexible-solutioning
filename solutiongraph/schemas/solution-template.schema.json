{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solution-template.schema.json",
  "title": "Universal Node Graph semantic solution template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_model_version", "id", "version", "title", "description",
    "domains", "tags", "program", "stages", "refinements", "extensions"
  ],
  "properties": {
    "template_model_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "program": {"$ref": "program-graph.schema.json"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "slot_ids", "extensions"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "slot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
          "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
        }
      }
    },
    "refinements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "trigger", "scopes", "proposal_strategy", "evaluation_contract",
          "stop_contract", "max_iterations", "budget_ref", "retain_history",
          "refresh_registry_snapshot", "extensions"
        ],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "trigger": {"$ref": "common.schema.json#/$defs/id"},
          "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
          "proposal_strategy": {"$ref": "common.schema.json#/$defs/id"},
          "evaluation_contract": {"type": "string", "minLength": 1},
          "stop_contract": {"type": "string", "minLength": 1},
          "max_iterations": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
          "budget_ref": {"type": "string"},
          "retain_history": {"type": "boolean"},
          "refresh_registry_snapshot": {"type": "boolean"},
          "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
        }
      }
    },
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
