{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-plan.schema.json",
  "title": "Effort-aware semantic interrogation question plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "interrogation_model_version", "dataset_profile_digest",
    "semantic_field_map_digest", "question_pack_digests", "budget", "items",
    "planner_id", "planner_version", "historical_revision", "warnings"
  ],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "interrogation_model_version": {"const": "0.1"},
    "dataset_profile_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "semantic_field_map_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "question_pack_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/digest"}},
    "budget": {"$ref": "#/$defs/budget"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "planner_id": {"$ref": "common.schema.json#/$defs/id"},
    "planner_version": {"type": "string", "minLength": 1},
    "historical_revision": {"$ref": "#/$defs/optionalDigest"},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "optionalDigest": {"oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/digest"}]},
    "optionalId": {"oneOf": [{"const": ""}, {"$ref": "common.schema.json#/$defs/id"}]},
    "optionalMode": {"enum": ["", "deterministic", "external", "llm", "human"]},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "effort_level", "allowed_modes", "granted_permissions", "max_cost_tier",
        "max_questions", "exhaustive", "exploration_fraction", "random_seed"
      ],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "effort_level": {"enum": [1, 3, 5, 7, 10]},
        "allowed_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["deterministic", "external", "llm", "human"]}},
        "granted_permissions": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
        "max_cost_tier": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_questions": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
        "exhaustive": {"type": "boolean"},
        "exploration_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "random_seed": {"type": "integer"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id", "question_digest", "pack_id", "status", "fields", "priority",
        "selected_capability", "selected_mode", "reasons", "historical_observations",
        "historical_utility"
      ],
      "properties": {
        "question_id": {"$ref": "common.schema.json#/$defs/id"},
        "question_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "pack_id": {"$ref": "common.schema.json#/$defs/id"},
        "status": {"enum": ["selected", "deferred", "blocked", "not-applicable"]},
        "fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "priority": {"type": "number"},
        "selected_capability": {"$ref": "#/$defs/optionalId"},
        "selected_mode": {"$ref": "#/$defs/optionalMode"},
        "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "historical_observations": {"type": "integer", "minimum": 0},
        "historical_utility": {"type": "number"}
      }
    }
  }
}
