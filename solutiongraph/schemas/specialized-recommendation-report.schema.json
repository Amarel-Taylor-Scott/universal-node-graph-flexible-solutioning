{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specialized-recommendation-report.schema.json",
  "title": "Specialized capability-pack recommendation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specialized_pack_model_version", "id", "request", "request_digest",
    "registry_digest", "recommendations", "recommended_pack_ids",
    "selection_limit", "scoring_method", "claim_boundary"
  ],
  "properties": {
    "specialized_pack_model_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "request": {"$ref": "specialized-task-request.schema.json"},
    "request_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "registry_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "recommendations": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/recommendation"}
    },
    "recommended_pack_ids": {"$ref": "#/$defs/idArray"},
    "selection_limit": {"type": "integer", "minimum": 1},
    "scoring_method": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "idArray": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "stringArray": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id", "pack_digest", "score", "status", "components",
        "matched_category_ids", "matched_terms", "matched_capability_ids",
        "missing_capability_ids", "matched_input_kind_ids",
        "matched_output_kind_ids", "matching_recipe_ids", "blocked_permissions",
        "reasons"
      ],
      "properties": {
        "pack_id": {"$ref": "common.schema.json#/$defs/id"},
        "pack_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["candidate", "partial", "excluded"]},
        "components": {
          "type": "object",
          "propertyNames": {"enum": ["terms", "categories", "capabilities", "inputs", "outputs", "preference"]},
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "matched_category_ids": {"$ref": "#/$defs/idArray"},
        "matched_terms": {"$ref": "#/$defs/stringArray"},
        "matched_capability_ids": {"$ref": "#/$defs/idArray"},
        "missing_capability_ids": {"$ref": "#/$defs/idArray"},
        "matched_input_kind_ids": {"$ref": "#/$defs/idArray"},
        "matched_output_kind_ids": {"$ref": "#/$defs/idArray"},
        "matching_recipe_ids": {"$ref": "#/$defs/idArray"},
        "blocked_permissions": {"$ref": "#/$defs/idArray"},
        "reasons": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
