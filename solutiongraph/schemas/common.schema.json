{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "optional_digest": {
      "oneOf": [
        {"const": ""},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.:/-]*\\.[a-z0-9_.:/-]+$"
      },
      "additionalProperties": true
    },
    "schema_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "versions"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "query_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "fields", "supports_filters", "supports_scores",
        "supports_explanations", "supports_cursor",
        "requires_embedding_space", "extensions"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "supports_filters": {"type": "boolean"},
        "supports_scores": {"type": "boolean"},
        "supports_explanations": {"type": "boolean"},
        "supports_cursor": {"type": "boolean"},
        "requires_embedding_space": {"type": "boolean"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "embedding_space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "model_id", "model_revision", "model_digest", "vector_kind",
        "dimensions", "distance", "normalization", "scalar_type", "targets",
        "extensions"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "model_id": {"$ref": "#/$defs/id"},
        "model_revision": {"type": "string", "minLength": 1},
        "model_digest": {"$ref": "#/$defs/optional_digest"},
        "vector_kind": {"enum": ["dense", "sparse", "multivector"]},
        "dimensions": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1}
          ]
        },
        "distance": {"$ref": "#/$defs/id"},
        "normalization": {"$ref": "#/$defs/id"},
        "scalar_type": {"$ref": "#/$defs/id"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type", "digest", "uri", "annotations"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "media_type": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "uri": {"type": "string"},
        "annotations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.:/-]*\\.[a-z0-9_.:/-]+$"
          },
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "value_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schema_digest", "media_type", "units"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1},
        "schema_digest": {"$ref": "#/$defs/optional_digest"},
        "media_type": {"type": "string", "minLength": 1},
        "units": {"type": "string"}
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "cardinality", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"$ref": "#/$defs/value_type"},
        "cardinality": {"enum": ["one", "optional", "many", "stream"]},
        "description": {"type": "string"}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_type", "required", "default", "choices", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "value_type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "default": true,
        "choices": {"type": "array"},
        "description": {"type": "string"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_slot", "source_port", "target_slot", "target_port"],
      "properties": {
        "source_slot": {"$ref": "#/$defs/id"},
        "source_port": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "target_slot": {"$ref": "#/$defs/id"},
        "target_port": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    }
  }
}
