{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-answer.schema.json",
  "title": "Structured human or LLM design-question answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["design_atlas_model_version", "question_id", "choice_id", "rationale", "evidence_refs", "assumptions", "confidence", "responder", "abstained"],
  "properties": {
    "design_atlas_model_version": {"const": "0.1"},
    "question_id": {"$ref": "common.schema.json#/$defs/id"},
    "choice_id": {"type": "string"},
    "rationale": {"type": "string"},
    "evidence_refs": {"$ref": "#/$defs/strings"},
    "assumptions": {"$ref": "#/$defs/strings"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "responder": {"$ref": "common.schema.json#/$defs/id"},
    "abstained": {"type": "boolean"}
  },
  "$defs": {"strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
