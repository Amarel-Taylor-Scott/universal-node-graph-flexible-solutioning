{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry-session.schema.json",
  "title": "Universal Node Graph negotiated registry session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discovery_version", "protocol_version", "registry_id", "registry_version",
    "registry_digest", "harness_id", "harness_version", "query_modes",
    "embedding_spaces", "descriptor_fields", "schema_versions",
    "supports_enumeration", "supports_snapshots", "supports_continuation",
    "supports_explanations", "max_page_size", "warnings"
  ],
  "properties": {
    "discovery_version": {"const": "0.1"},
    "protocol_version": {"type": "string", "minLength": 1},
    "registry_id": {"$ref": "common.schema.json#/$defs/id"},
    "registry_version": {"type": "string", "minLength": 1},
    "registry_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "harness_id": {"$ref": "common.schema.json#/$defs/id"},
    "harness_version": {"type": "string", "minLength": 1},
    "query_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "embedding_spaces": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/embedding_space"}},
    "descriptor_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "schema_versions": {
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/$defs/id"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "supports_enumeration": {"type": "boolean"},
    "supports_snapshots": {"type": "boolean"},
    "supports_continuation": {"type": "boolean"},
    "supports_explanations": {"type": "boolean"},
    "max_page_size": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
