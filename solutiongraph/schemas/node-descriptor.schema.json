{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-descriptor.schema.json",
  "title": "Universal Node Graph discovery descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discovery_version", "node_id", "node_version", "node_spec_digest",
    "title", "summary", "purposes", "solutions", "actions", "domains",
    "tags", "aliases", "ports", "documents", "extensions"
  ],
  "properties": {
    "discovery_version": {"const": "0.1"},
    "node_id": {"$ref": "common.schema.json#/$defs/id"},
    "node_version": {"type": "string", "minLength": 1},
    "node_spec_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "purposes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "solutions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "domains": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction", "port_name", "description", "concepts", "examples"],
        "properties": {
          "direction": {"enum": ["input", "output"]},
          "port_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string"},
          "concepts": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
          "examples": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "language", "targets", "source_digest", "extensions"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "text": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_digest": {"$ref": "common.schema.json#/$defs/optional_digest"},
          "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
        }
      }
    },
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
