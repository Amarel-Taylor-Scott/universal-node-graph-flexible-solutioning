{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specialized-composition-request.schema.json",
  "title": "Specialized capability-pack composition request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "starting_kind_ids", "goal_kind_ids", "pack_ids",
    "required_capability_ids", "max_steps", "state_budget", "candidate_limit"
  ],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "starting_kind_ids": {"$ref": "#/$defs/idArrayRequired"},
    "goal_kind_ids": {"$ref": "#/$defs/idArrayRequired"},
    "pack_ids": {"$ref": "#/$defs/idArray"},
    "required_capability_ids": {"$ref": "#/$defs/idArray"},
    "max_steps": {"type": "integer", "minimum": 1},
    "state_budget": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
    },
    "candidate_limit": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
    }
  },
  "$defs": {
    "idArray": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "idArrayRequired": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    }
  }
}
