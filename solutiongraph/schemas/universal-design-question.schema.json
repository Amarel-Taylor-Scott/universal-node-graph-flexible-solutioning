{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "universal-design-question.schema.json",
  "title": "Universal engineering design question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "universal_engineering_model_version", "id", "obligation_id", "prompt",
    "why_it_matters", "evidence_requests", "suggested_checks", "response_modes",
    "required_permissions", "priority", "effort_cost"
  ],
  "properties": {
    "universal_engineering_model_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "obligation_id": {"$ref": "common.schema.json#/$defs/id"},
    "prompt": {"type": "string", "minLength": 1},
    "why_it_matters": {"type": "string", "minLength": 1},
    "evidence_requests": {"$ref": "#/$defs/stringArray"},
    "suggested_checks": {"$ref": "#/$defs/stringArray"},
    "response_modes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["deterministic", "human", "llm", "external"]}
    },
    "required_permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "priority": {"type": "integer", "minimum": 1, "maximum": 10},
    "effort_cost": {"type": "integer", "minimum": 1, "maximum": 10}
  },
  "$defs": {
    "stringArray": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
