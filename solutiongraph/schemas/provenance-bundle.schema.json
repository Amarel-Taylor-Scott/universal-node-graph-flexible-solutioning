{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance-bundle.schema.json",
  "title": "SolutionGraph Provenance Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance_model_version", "receipt_id", "receipt_digest", "w3c_prov", "openlineage", "slsa_provenance"],
  "properties": {
    "provenance_model_version": {"const": "0.1"},
    "receipt_id": {"$ref": "common.schema.json#/$defs/id"},
    "receipt_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "w3c_prov": {"type": "object"},
    "openlineage": {"type": "object"},
    "slsa_provenance": {"type": "object"}
  }
}
