{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-blueprint.schema.json",
  "title": "SolutionGraph linear template authoring blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprint_model_version",
    "id",
    "version",
    "title",
    "description",
    "task",
    "success_contract",
    "domains",
    "tags",
    "stages"
  ],
  "properties": {
    "blueprint_model_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "success_contract": {"type": "string", "minLength": 1},
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "allowed_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "granted_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "invariants": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    },
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "slots"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/slot"}
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "success_contract",
        "required_capabilities"
      ],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "purpose": {"type": "string", "minLength": 1},
        "success_contract": {"type": "string", "minLength": 1},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/id"}
        },
        "allowed_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/id"}
        },
        "optional": {"type": "boolean"}
      }
    }
  }
}
