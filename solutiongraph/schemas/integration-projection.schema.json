{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "integration-projection.schema.json",
  "title": "External standard projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "integration_model_version", "id", "adapter_id", "adapter_digest",
    "source_kind", "source_version", "source_digest", "operations", "limitations"
  ],
  "properties": {
    "integration_model_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "adapter_id": {"$ref": "common.schema.json#/$defs/id"},
    "adapter_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "source_kind": {"$ref": "common.schema.json#/$defs/id"},
    "source_version": {"type": "string", "minLength": 1},
    "source_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "limitations": {"$ref": "#/$defs/stringArray"}
  },
  "$defs": {
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "stringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "source_ref", "kind", "label", "dependencies", "input_type_ids",
        "output_type_ids", "effects", "permissions", "metadata"
      ],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "source_ref": {"type": "string", "minLength": 1},
        "kind": {"$ref": "common.schema.json#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "dependencies": {"$ref": "#/$defs/idArray"},
        "input_type_ids": {"$ref": "#/$defs/idArray"},
        "output_type_ids": {"$ref": "#/$defs/idArray"},
        "effects": {"$ref": "#/$defs/idArray"},
        "permissions": {"$ref": "#/$defs/idArray"},
        "metadata": {"type": "object"}
      }
    }
  }
}
