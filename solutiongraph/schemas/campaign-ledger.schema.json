{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-ledger.schema.json",
  "title": "Universal Node Graph Campaign Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_model_version", "candidates", "decisions"],
  "properties": {
    "campaign_model_version": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "items": {"$ref": "candidate-record.schema.json"}
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "candidate_id", "decision", "reason", "receipt_ids", "decided_at"
        ],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "candidate_id": {"$ref": "common.schema.json#/$defs/id"},
          "decision": {
            "enum": ["retain", "promote", "reject", "quarantine", "invalidate"]
          },
          "reason": {"type": "string", "minLength": 1},
          "receipt_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/id"}
          },
          "decided_at": {"type": "string"}
        }
      }
    }
  }
}
