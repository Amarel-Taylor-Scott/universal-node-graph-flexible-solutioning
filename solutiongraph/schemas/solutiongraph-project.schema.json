{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solutiongraph-project.schema.json",
  "title": "SolutionGraph starter project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "template_id", "template_version",
    "template_digest", "status", "next_gate"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "template_id": {"$ref": "common.schema.json#/$defs/id"},
    "template_version": {"type": "string", "minLength": 1},
    "template_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "status": {"enum": ["template_selected"]},
    "next_gate": {"const": "instantiate_task_contract"}
  }
}
