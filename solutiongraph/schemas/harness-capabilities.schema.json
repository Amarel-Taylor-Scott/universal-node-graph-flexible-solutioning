{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-capabilities.schema.json",
  "title": "Universal Node Graph harness capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discovery_version", "harness_id", "harness_version", "protocol_versions",
    "schemas", "query_modes", "embedding_spaces", "descriptor_fields",
    "require_explanations", "require_snapshots", "require_enumeration", "extensions"
  ],
  "properties": {
    "discovery_version": {"const": "0.1"},
    "harness_id": {"$ref": "common.schema.json#/$defs/id"},
    "harness_version": {"type": "string", "minLength": 1},
    "protocol_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "schemas": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/schema_support"}},
    "query_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "embedding_spaces": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/embedding_space"}},
    "descriptor_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "require_explanations": {"type": "boolean"},
    "require_snapshots": {"type": "boolean"},
    "require_enumeration": {"type": "boolean"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
