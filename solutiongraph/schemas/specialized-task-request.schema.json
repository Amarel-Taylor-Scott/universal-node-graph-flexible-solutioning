{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specialized-task-request.schema.json",
  "title": "Specialized capability-pack recommendation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "description", "category_ids", "input_kind_ids", "output_kind_ids",
    "required_capability_ids", "preferred_pack_ids", "excluded_pack_ids",
    "granted_permissions"
  ],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "description": {"type": "string", "minLength": 1},
    "category_ids": {"$ref": "#/$defs/idArray"},
    "input_kind_ids": {"$ref": "#/$defs/idArray"},
    "output_kind_ids": {"$ref": "#/$defs/idArray"},
    "required_capability_ids": {"$ref": "#/$defs/idArray"},
    "preferred_pack_ids": {"$ref": "#/$defs/idArray"},
    "excluded_pack_ids": {"$ref": "#/$defs/idArray"},
    "granted_permissions": {"$ref": "#/$defs/idArray"}
  },
  "$defs": {
    "idArray": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    }
  }
}
