{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-question.schema.json",
  "title": "Evidence-seeking data-science design question",
  "type": "object",
  "additionalProperties": false,
  "required": ["design_atlas_model_version", "id", "version", "pack_id", "title", "prompt", "rationale", "response_modes", "cost_tier", "risk_weight", "required_evidence", "choices", "trigger_any", "trigger_all", "exclude_when", "experiment_template", "stop_conditions", "reference_ids", "tags"],
  "properties": {
    "design_atlas_model_version": {"const": "0.1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "pack_id": {"$ref": "common.schema.json#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "response_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["deterministic", "llm", "human", "external"]}},
    "cost_tier": {"type": "integer", "minimum": 1, "maximum": 10},
    "risk_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "required_evidence": {"$ref": "#/$defs/idArray"},
    "choices": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/choice"}},
    "trigger_any": {"$ref": "#/$defs/idArray"},
    "trigger_all": {"$ref": "#/$defs/idArray"},
    "exclude_when": {"$ref": "#/$defs/idArray"},
    "experiment_template": {"type": "string"},
    "stop_conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reference_ids": {"$ref": "#/$defs/idArray"},
    "tags": {"$ref": "#/$defs/idArray"}
  },
  "$defs": {
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "consequence", "action_ids", "technique_tags"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1},
        "action_ids": {"$ref": "#/$defs/idArray"},
        "technique_tags": {"$ref": "#/$defs/idArray"}
      }
    }
  }
}
