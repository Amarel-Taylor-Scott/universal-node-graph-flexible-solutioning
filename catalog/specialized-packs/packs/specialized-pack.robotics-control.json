  "gates": [
    {
      "decision": "reject",
      "description": "Reject plans with feasibility, safety, robustness, or recovery failures in the fixed scenario suite.",
      "id": "gate.robotics-control.simulation",
      "independent": true,
      "metric_ids": [
        "metric.robotics-control.constraint-violations",
        "metric.robotics-control.safety-margin",
        "metric.robotics-control.task-success",
        "metric.robotics-control.safe-recovery"
      ],
      "oracle_kind": "property",
      "title": "Robotics simulation gate"
    },
    {
      "decision": "escalate",
      "description": "Escalate every consequential physical execution to an independently enforced controller and accountable approval boundary.",
      "id": "gate.robotics-control.physical-authority",
      "independent": true,
      "metric_ids": [
        "metric.robotics-control.safety-margin",
        "metric.robotics-control.safe-recovery"
      ],
      "oracle_kind": "human",
      "title": "Physical execution authority gate"
    }
  ],
  "id": "specialized-pack.robotics-control",
  "license": "MIT",
  "limitations": [
    "Executable evidence is simulation-only and grants no physical-device authority."
  ],
  "metrics": [
    {
      "description": "Kinematic, dynamic, collision, timing, energy, authority, and safety violations.",
      "direction": "minimize",
      "id": "metric.robotics-control.constraint-violations",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.plan",
      "title": "Constraint violations",
      "unit": "count"
    },
    {
      "description": "Minimum observed margin to declared collision, force, speed, region, and human-safety limits.",
      "direction": "maximize",
      "id": "metric.robotics-control.safety-margin",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.simulation",
      "title": "Safety margin",
      "unit": "distance"
    },
    {
      "description": "Independently verified goal completion across nominal and perturbation scenarios.",
      "direction": "maximize",
      "id": "metric.robotics-control.task-success",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.scenario",
      "title": "Task success",
      "unit": "ratio"
    },
    {
      "description": "Failures reaching a declared safe state within the response contract.",
      "direction": "maximize",
      "id": "metric.robotics-control.safe-recovery",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.failure",
      "title": "Safe recovery",
      "unit": "ratio"
    }
  ],
