  },
  "gates": [
    {
      "decision": "reject",
      "description": "Reject consequential outputs when task acceptance or source grounding fails.",
      "id": "gate.llm-engineering.grounded-response",
      "independent": true,
      "metric_ids": [
        "metric.llm-engineering.task-acceptance",
        "metric.llm-engineering.groundedness"
      ],
      "oracle_kind": "cross-implementation",
      "title": "Grounded response gate"
    },
    {
      "decision": "reject",
      "description": "Reject promotion when the fixed red-team suite exceeds its declared failure threshold.",
      "id": "gate.llm-engineering.adversarial-safety",
      "independent": true,
      "metric_ids": [
        "metric.llm-engineering.adversarial-failure"
      ],
      "oracle_kind": "property",
      "title": "Adversarial safety gate"
    },
    {
      "decision": "reject",
      "description": "Reject promotion unless diverse judges, human samples, and candidate-unreadable holdouts satisfy the predeclared protocol.",
      "id": "gate.llm-engineering.sealed-promotion",
      "independent": true,
      "metric_ids": [
        "metric.llm-engineering.judge-agreement",
        "metric.llm-engineering.sealed-holdout-acceptance"
      ],
      "oracle_kind": "human",
      "title": "Sealed promotion gate"
    }
  ],
  "id": "specialized-pack.llm-engineering",
  "license": "MIT",
  "limitations": [
    "This capability pack recommends authoring assets; compiler admission and a task-specific SolutionPackManifest are still required before execution."
  ],
  "metrics": [
    {
      "description": "Share of scenarios accepted by the separately identified task oracle.",
      "direction": "maximize",
      "id": "metric.llm-engineering.task-acceptance",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.scenario",
      "title": "Task acceptance",
      "unit": "ratio"
    },
    {
      "description": "Share of material claims supported by authorized source evidence under the fixed citation evaluator.",
      "direction": "maximize",
      "id": "metric.llm-engineering.groundedness",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.response",
      "title": "Groundedness",
      "unit": "ratio"
    },
    {
      "description": "Share of adversarial scenarios causing a declared safety, policy, or integrity failure.",
      "direction": "minimize",
      "id": "metric.llm-engineering.adversarial-failure",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.stress",
      "title": "Adversarial failure rate",
      "unit": "ratio"
    },
    {
      "description": "Agreement and calibrated disagreement across independent judges and human adjudication samples.",
      "direction": "maximize",
      "id": "metric.llm-engineering.judge-agreement",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.evaluation",
      "title": "Judge agreement",
      "unit": "ratio"
    },
    {
      "description": "Measured model, tool, and infrastructure cost divided by accepted outputs.",
      "direction": "minimize",
      "id": "metric.llm-engineering.cost-per-accepted",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.run",
      "title": "Cost per accepted result",
      "unit": "currency-per-result"
    },
    {
      "description": "Measured end-to-end latency including retrieval, tools, generation, and independent evaluation.",
      "direction": "minimize",
      "id": "metric.llm-engineering.latency",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.run",
      "title": "End-to-end latency",
      "unit": "milliseconds"
    },
    {
      "description": "Acceptance on candidate-unreadable scenarios and evaluator infrastructure.",
      "direction": "maximize",
      "id": "metric.llm-engineering.sealed-holdout-acceptance",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.holdout",
      "title": "Sealed holdout acceptance",
      "unit": "ratio"
    }
  ],
