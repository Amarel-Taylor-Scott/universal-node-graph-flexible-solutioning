    }
  ],
  "id": "specialized-pack.education-assessment",
  "license": "MIT",
  "limitations": [
    "The package provides design-time contracts only; high-stakes assessment requires validated instruments, qualified educators, accessibility review, appeal, privacy governance, and jurisdiction-specific controls."
