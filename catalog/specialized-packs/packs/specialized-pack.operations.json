{
  "delivery": {
    "current_distribution": "browsergraph",
    "entry_point_group": "solutiongraph.specialized_packs",
    "entry_point_name": "operations",
    "extraction_target": "solutiongraph-pack-operations",
    "python_module": "solutiongraph.specialized.operations"
  },
  "description": "Observability, SLOs, incident response, recovery, compliance evidence, governed workflows, and constrained operational planning.",
  "domain_pack_ids": [
    "domain-pack.sre-incident",
    "domain-pack.security-compliance",
    "domain-pack.business-human-workflow"
  ],
  "extensions": {
    "solutiongraph.delivery": "bundled-extraction-ready"
  },
  "gates": [
    {
      "decision": "reject",
      "description": "Reject a recovery or rollout state that fails the declared SLO or independent health oracle.",
      "id": "gate.operations.service-health",
      "independent": true,
      "metric_ids": [
        "metric.operations.slo-attainment",
        "metric.operations.recovery-success"
      ],
      "oracle_kind": "property",
      "title": "Service health gate"
    },
    {
      "decision": "escalate",
      "description": "Escalate when detection or recovery exceeds policy, evidence is incomplete, or authority is unavailable.",
      "id": "gate.operations.incident-response",
      "independent": true,
      "metric_ids": [
        "metric.operations.detection-time",
        "metric.operations.recovery-time"
      ],
      "oracle_kind": "human",
      "title": "Incident response gate"
    },
    {
      "decision": "reject",
      "description": "Reject operational plans that violate hard feasibility or required control-evidence boundaries.",
      "id": "gate.operations.governed-plan",
      "independent": true,
      "metric_ids": [
        "metric.operations.control-coverage",
        "metric.operations.plan-feasibility"
      ],
      "oracle_kind": "external-authority",
      "title": "Governed plan gate"
    }
  ],
  "id": "specialized-pack.operations",
  "license": "MIT",
  "limitations": [
    "This capability pack recommends authoring assets; compiler admission and a task-specific SolutionPackManifest are still required before execution."
  ],
  "metrics": [
    {
      "description": "Observed attainment of the declared service-level objective over its fixed window.",
      "direction": "maximize",
      "id": "metric.operations.slo-attainment",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.service",
      "title": "SLO attainment",
      "unit": "ratio"
    },
    {
      "description": "Time from fixed incident onset to an actionable independently recorded alert.",
      "direction": "minimize",
      "id": "metric.operations.detection-time",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.incident",
      "title": "Detection time",
      "unit": "seconds"
    },
    {
      "description": "Time from incident declaration to independently verified service recovery.",
      "direction": "minimize",
      "id": "metric.operations.recovery-time",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.incident",
      "title": "Recovery time",
      "unit": "seconds"
    },
    {
      "description": "Share of injected or observed incidents recovered within policy without undeclared effects.",
      "direction": "maximize",
      "id": "metric.operations.recovery-success",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.incident",
      "title": "Recovery success",
      "unit": "ratio"
    },
    {
      "description": "Share of required controls bound to current source, test, exception, owner, and review evidence.",
      "direction": "maximize",
      "id": "metric.operations.control-coverage",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.governance",
      "title": "Control coverage",
      "unit": "ratio"
    },
    {
      "description": "Share of proposed operational decisions satisfying all hard resource and policy constraints.",
      "direction": "maximize",
      "id": "metric.operations.plan-feasibility",
      "required_evidence": [
        "evidence.independent-evaluation"
      ],
      "scope": "scope.plan",
      "title": "Plan feasibility",
      "unit": "ratio"
    }
  ],
