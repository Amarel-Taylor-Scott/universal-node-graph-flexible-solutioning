      "decision": "reject",
      "description": "Reject evidence claims without cohort validity, exact grounding, uncertainty, and applicability boundaries.",
      "id": "gate.healthcare-biomedical.evidence",
      "independent": true,
      "metric_ids": [
        "metric.healthcare-biomedical.cohort-validity",
        "metric.healthcare-biomedical.evidence-grounding"
      ],
      "oracle_kind": "cross-implementation",
      "title": "Biomedical evidence gate"
    },
    {
      "decision": "escalate",
      "description": "Escalate every consequential clinical recommendation without independent validation, subgroup evidence, abstention, and accountable qualified review.",
      "id": "gate.healthcare-biomedical.clinical-use",
      "independent": true,
      "metric_ids": [
        "metric.healthcare-biomedical.subgroup-performance",
        "metric.healthcare-biomedical.unsafe-decision"
      ],
      "oracle_kind": "human",
      "title": "Clinical-use authority gate"
    }
  ],
  "id": "specialized-pack.healthcare-biomedical",
  "license": "MIT",
  "limitations": [
    "The package supplies design-time evidence contracts only; regulated or clinical use requires jurisdiction-specific governance, validated data and systems, qualified oversight, and production adapters."
