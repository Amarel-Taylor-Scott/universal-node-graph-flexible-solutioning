  "gates": [
    {
      "decision": "reject",
      "description": "Reject deployment unless fixed quality, compatibility, policy, latency, and cost requirements pass.",
      "id": "gate.ml-engineering.release",
      "independent": true,
      "metric_ids": [
        "metric.ml-engineering.release-acceptance",
        "metric.ml-engineering.serving-latency",
        "metric.ml-engineering.serving-cost"
      ],
      "oracle_kind": "cross-implementation",
      "title": "Model release gate"
    },
    {
      "decision": "reject",
      "description": "Reject promotion when rollback cannot be verified or drift evidence cannot trigger a bounded response.",
      "id": "gate.ml-engineering.rollback",
      "independent": true,
      "metric_ids": [
        "metric.ml-engineering.recovery-time",
        "metric.ml-engineering.drift-detection-delay"
      ],
      "oracle_kind": "property",
      "title": "Rollback and monitoring gate"
    },
    {
      "decision": "escalate",
      "description": "Escalate when synthetic data does not improve or preserve untouched real-data evidence across protected slices.",
      "id": "gate.ml-engineering.synthetic-supplement",
      "independent": true,
      "metric_ids": [
        "metric.ml-engineering.synthetic-utility-gap"
      ],
      "oracle_kind": "statistical",
      "title": "Synthetic supplementation gate"
    }
  ],
